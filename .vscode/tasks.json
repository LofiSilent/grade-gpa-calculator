{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GPA: Start development server",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/start-dev.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "gpa-vite",
        "pattern": { "regexp": "^(never-match)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:.*http://127.0.0.1:5173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
